# Infra Environment Variables
# Copy to .env and fill in values

# Webhook secret (must match GitHub webhook secret)
WEBHOOK_SECRET=your-github-webhook-secret-here

# Central PostgreSQL superuser (docker-compose.yml refuses to start without it)
POSTGRES_PASSWORD=change-me

# Role created by database/01-create-cashalot-database.sh (also required by docker-compose.yml)
CASHALOT_DB_PASSWORD=change-me

# Pi-hole admin password
PIHOLE_PASSWORD=your-pihole-admin-password
